# Backend configuration (set in Koyeb → Service → Environment Variables).

# Telegram bot token from @BotFather. When set, /ledger/* and /api/create-invoice
# require a valid, fresh Telegram initData signature.
BOT_TOKEN=

# Public webhook URL for Telegram payment updates (auto-registered on boot).
WEBHOOK_URL=https://your-service.koyeb.app/webhook

# Optional secret that authenticates Telegram webhook deliveries.
WEBHOOK_SECRET=

# CORS origin for the browser frontend ("*" is safe — auth is via initData).
CORS_ORIGIN=*

# Port the service listens on (Koyeb exposes this).
PORT=8000

# How long a Telegram initData session stays valid.
INITDATA_MAX_AGE_MS=86400000

# Must stay 0 in production: only the payment webhook may credit stars.
ALLOW_CLIENT_TOPUP=0

# Where the ledger journal lives (container disk).
LEDGER_FILE=data/ledger.jsonl
