# Frontend build-time configuration (set in Vercel → Project → Environment Variables).
# Leave empty to run the app in offline/solo mode (bots only, no live backend).

# Full URL of the deployed Koyeb backend (no trailing slash).
# It drives matchmaking (wss://…/match), PeerJS signaling (/peerjs) and the ledger.
VITE_GAME_SERVER=https://your-service.koyeb.app
