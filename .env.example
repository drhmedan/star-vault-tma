# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_BOT_USERNAME="StarVaultBot"

# TiDB Serverless Database (Free 25GB)
TIDB_HOST="gateway01.eu-central-1.prod.aws.tidbcloud.com"
TIDB_PORT="4000"
TIDB_USER="your_tidb_user"
TIDB_PASSWORD="your_tidb_password"
TIDB_DATABASE="star_vault"

# WebApp URL (After Vercel/Cloudflare deploy)
WEBAPP_URL="https://star-vault-tma.vercel.app"

# ============================================================
# Live backend (matchmaking + WebRTC signaling)
# ============================================================
# Point this at the deployed Koyeb container to enable live matchmaking
# and self-hosted WebRTC signaling. Both endpoints live on one URL:
#   - matchmaking WebSocket : /match
#   - PeerJS signaling      : /peerjs
#
# Copy this file to `.env.local` and set the URL:
#   VITE_GAME_SERVER=https://your-service.koyeb.app
#
# When left unset, the game runs in offline mode (instant bot battles).
# ============================================================
VITE_GAME_SERVER=
